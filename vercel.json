{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/features/ping_post",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/ping_post",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/features/ping_post_integration",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/ping_post_integration",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/features/voice_agents",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/voice_agents",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/features/voice_agents/elevenlabs",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/voice_agents/elevenlabs",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/blog/ping-post-explained",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/ping-post-explained",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/power-dialer-basics",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/power-dialer-basics",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/features/twilio",
      "destination": "/features/multiple_telephone_providers",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/twilio",
      "destination": "/:lang/features/multiple_telephone_providers",
      "permanent": false
    },
    {
      "source": "/blog/call-tracking-for-healthcare-practices",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/call-tracking-for-healthcare-practices",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/real-estate-calls-from-listing-to-showing",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/real-estate-calls-from-listing-to-showing",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/agency-playbook-proving-call-quality",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/agency-playbook-proving-call-quality",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/call-attribution-explained",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/call-attribution-explained",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/pay-per-call-margin-leaks",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/pay-per-call-margin-leaks",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/sending-call-conversions-to-ad-platforms",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/sending-call-conversions-to-ad-platforms",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/what-ai-call-scoring-measures",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/what-ai-call-scoring-measures",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/call-recording-retention-and-access",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/call-recording-retention-and-access",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/hold-queues-and-failover",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/hold-queues-and-failover",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/web-forms-into-live-calls",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/web-forms-into-live-calls",
      "destination": "/:lang/blog",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(avx-motion|avx-site|avx-theme|avx-i18n)/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/avx-fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(webp|png|jpg|jpeg|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/avx-baked/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-ringba/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/trackdrive_marketing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg|favicon-32\\.png|favicon-192\\.png|apple-touch-icon-blue\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-shots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/avx-blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
