{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/healthcare-call-tracking-measure-marketing-roi",
      "destination": "/blog/call-tracking-for-healthcare-practices",
      "permanent": true
    },
    {
      "source": "/blog/real-estate-call-tracking-track-every-lead",
      "destination": "/blog/real-estate-calls-from-listing-to-showing",
      "permanent": true
    },
    {
      "source": "/blog/marketing-agency-call-tracking-success-story",
      "destination": "/blog/agency-playbook-proving-call-quality",
      "permanent": true
    },
    {
      "source": "/features/ping_post",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/ping_post",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/features/ping_post_integration",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/ping_post_integration",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/features/voice_agents",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/voice_agents",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/features/voice_agents/elevenlabs",
      "destination": "/features",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/voice_agents/elevenlabs",
      "destination": "/:lang/features",
      "permanent": false
    },
    {
      "source": "/blog/ping-post-explained",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/ping-post-explained",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/blog/power-dialer-basics",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/blog/power-dialer-basics",
      "destination": "/:lang/blog",
      "permanent": false
    },
    {
      "source": "/features/twilio",
      "destination": "/features/multiple_telephone_providers",
      "permanent": false
    },
    {
      "source": "/:lang(ru|ja|zh)/features/twilio",
      "destination": "/:lang/features/multiple_telephone_providers",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/avx-baked/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-ringba/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/trackdrive_marketing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg|favicon-32\\.png|favicon-192\\.png|apple-touch-icon-blue\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-shots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/avx-fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/avx-blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
