# Careers applications (api/apply.js). Copy to .env.local for `npm run dev`, and add the same
# keys in Vercel → Project → Settings → Environment Variables for the live site.

# Telegram: a bot from @BotFather, and the chat it posts CVs to (a group, or a person who
# pressed Start on the bot). `TELEGRAM_BOT_TOKEN=... node scripts/telegram-chat-id.js` finds the id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: the mailbox that sends each application (for Gmail / Google Workspace: smtp.gmail.com,
# port 465, and an app password), and who receives it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CAREERS_EMAIL_TO=hello@avortyx.io

# The careers backend the application form posts to. Live: the Flask backend on the Hostinger VPS,
#   VITE_APPLY_URL=https://api.avortyx.com/careers/apply
# (set in Vercel → Production since 2026-10-15; locally, http://localhost:5055/careers/apply)
# It sends the Telegram alerts (the bot), the team and applicant emails, and keeps every application
# in its panel (https://api.avortyx.com/panel). With it set, api/apply.js is not used and the
# TELEGRAM_* / SMTP_* keys above are not needed on Vercel: they live in the backend's .env.
# Leave empty to fall back to api/apply.js on this site (no bot, no panel).
VITE_APPLY_URL=

# The request-access form posts here, then opens /request-access/thanks. Live:
#   VITE_ACCESS_URL=https://api.avortyx.com/access/request
# Leave empty and the form opens an email to the team instead (no thank-you page).
VITE_ACCESS_URL=

# The help chat's live line to the team: once a visitor picks a teammate, their messages go here
# and on to the support group on Telegram, and the team's replies come back to the chat box. Live:
#   VITE_CHAT_URL=https://api.avortyx.com/chat
# (locally, http://localhost:5055/chat). Leave empty and picking a teammate points to /p/contact.
VITE_CHAT_URL=
